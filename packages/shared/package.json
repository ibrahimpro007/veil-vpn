{
  "description": "VeilVPN shared contracts: Zod schemas, types, and the OpenAPI 3.1 spec. Imported by api, admin, and node-agent.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "name": "@veil/shared",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "copy-openapi": "cp src/openapi.yaml dist/openapi.yaml",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "types": "./dist/index.d.ts",
  "version": "0.1.0",
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
