# VeilVPN API — Cloudflare Worker (apps/api)
# Copy to .dev.vars for local `wrangler dev` (NEVER commit .dev.vars).
# Production secrets: `wrangler secret put <NAME>` — they are NOT in wrangler.toml.

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
# D1 database id for veil-vpn-db (from `wrangler d1 create veil-vpn-db`)
D1_DATABASE_ID=
# KV namespace id for RATE_LIMIT (from `wrangler kv namespace create RATE_LIMIT`)

# Auth — EdDSA (Ed25519) keys for access JWTs. Generate with:
#   openssl genpkey -algorithm ed25519 -out ed25519.pem
#   openssl pkey -in ed25519.pem -pubout -out ed25519-pub.pem
# Store the PEM contents (single-line \n escaped) via `wrangler secret put`.
JWT_EDDSA_PRIVATE_KEY=
JWT_EDDSA_PUBLIC_KEY=
# Optional token TTL overrides (seconds; defaults 900 / 2592000)
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=2592000
# JWT issuer claim (default "veil-api")
# JWT_ISSUER=veil-api

# App URLs
APP_URL=https://veil.example
API_PUBLIC_URL=https://api.veil.example
ADMIN_URL=https://admin.veil.example

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@veil.example

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# plan slug -> Stripe price id mapping is stored in plans.provider_product_refs

# LemonSqueezy
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=

# Node agent control-plane auth
# HMAC-SHA256 over "<timestamp>.<method>.<path>.<sha256(body)>"
# header X-Veil-Signature + X-Veil-Timestamp, 5-min skew (see PHASE1_NOTES.md)
NODE_AGENT_HMAC_SECRET=

# Admin console: AES-GCM key encrypting admin TOTP secrets (32 random bytes, base64)
ADMIN_TOTP_ENC_KEY=

# Mobile IAP verification
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
APPLE_APPSTORE_ISSUER_ID=
APPLE_APPSTORE_KEY_ID=
APPLE_APPSTORE_PRIVATE_KEY=
