# VeilVPN node agent (apps/node-agent) — Go service running on each VPN exit node.
# Implemented in Phase 4. The installer writes the real values to
# /etc/veil-agent/agent.env (0600, root:veil); this file is documentation.

# --- control plane ---
# Base URL of the Cloudflare Worker API (informational; the API calls the agent, not vice versa).
VEIL_API_BASE=https://api.veil.example
# Node id as registered in the API's vpn_nodes table (informational, used in log lines).
VEIL_NODE_ID=

# --- HMAC auth (REQUIRED) ---
# Must match the API's NODE_AGENT_HMAC_SECRET. Minimum 32 characters.
# The agent also accepts the legacy Phase 1 name VEIL_HMAC_SECRET as fallback.
AGENT_HMAC_SECRET=<redacted>
# Previous secret, accepted during rotation. Unset when rotation completes.
AGENT_HMAC_SECRET_PREV=

# --- WireGuard ---
WG_INTERFACE=wg0
# UDP port WireGuard listens on (used by the bootstrap for wg0.conf / nftables; the agent itself only needs WG_INTERFACE).
WG_LISTEN_PORT=51820
IP_POOL_CIDR=10.7.0.0/24
# Gateway/DNS address inside the pool; never assigned to peers.
DNS_IP=10.7.0.1

# --- agent networking ---
# HTTPS port for the control API. The API reaches the agent at https://<node-ip>:AGENT_PORT.
AGENT_PORT=8443
# Bind address. 0.0.0.0 is required so the control plane can reach the agent over the internet
# (access is restricted by TLS + HMAC + the cloud firewall allowlist).
AGENT_BIND=0.0.0.0
# TLS certificate/key for the agent's HTTPS server. Self-signed is fine —
# the API pins the certificate's SHA-256 fingerprint instead of trusting a CA.
AGENT_TLS_CERT=/etc/veil-agent/tls/cert.pem
AGENT_TLS_KEY=/etc/veil-agent/tls/key.pem

# --- sync loop ---
PEER_SYNC_INTERVAL_SECONDS=60

# --- local state ---
# Directory holding peers.json (desired peer state). Must be writable by the veil user.
AGENT_STATE_DIR=/var/lib/veil-agent

# --- logging ---
# Set to 1 to enable debug logs (the ONLY level that may include peer keys/IPs). Off by default.
AGENT_DEBUG=0
# Alternative: LOG_LEVEL=debug
LOG_LEVEL=info
# Systemd notify socket (NOTIFY_SOCKET). Set automatically by systemd when
# Type=notify is used (see deploy/veil-agent.service); leave unset otherwise.
# NOTIFY_SOCKET=
