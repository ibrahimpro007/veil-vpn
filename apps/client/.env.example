# VeilVPN Flutter client (apps/client)
# No API keys ship in the app. Build-time config only, via --dart-define:
#
#   flutter build apk \
#     --dart-define=API_BASE_URL=https://api.veil.example \
#     --dart-define=FLAVOR=direct \
#     --dart-define=GITHUB_REPO=myorg/veil-vpn
#
# API_BASE_URL  API origin WITHOUT the /v1 prefix (paths add it themselves).
# FLAVOR        direct (default; GitHub Releases) | play | macstore.
#               Store flavors compile but store billing stays INACTIVE without
#               store accounts + products (see lib/billing/store_billing.dart).
# GITHUB_REPO   owner/repo for the in-app update checker (direct flavor only).
