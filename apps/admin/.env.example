# VeilVPN admin console (apps/admin) — Next.js
# Deployed as its own Vercel project (root directory: apps/admin).

# Worker API base for /admin/* routes. NOTE: the name NEXT_PUBLIC_API_BASE_URL
# is pinned by PHASE1_NOTES.md ("Env var names (exact — do not rename)").
# Example: https://api.veil.example  (no trailing slash, no /v1 suffix —
# admin routes live at <base>/admin/..., NOT <base>/v1/...)
NEXT_PUBLIC_API_BASE_URL=https://api.veil.example
# Admin session cookie signing secret (32+ random bytes, base64)
# (Reserved for a future httpOnly-cookie session proxy; the current build
# stores the admin JWT in memory + sessionStorage — see README.)
ADMIN_SESSION_SECRET=
# Admin TOTP encryption must MATCH apps/api ADMIN_TOTP_ENC_KEY (same AES-GCM key)
ADMIN_TOTP_ENC_KEY=
