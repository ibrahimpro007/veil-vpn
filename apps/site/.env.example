# VeilVPN site — environment variables
# Copy to .env.local and fill in. All of these are public (NEXT_PUBLIC_*)
# and are embedded in the built site.

# Base URL of the VeilVPN API (Cloudflare Worker). Used for account links
# and any client-side API calls.
NEXT_PUBLIC_API_BASE_URL=https://api.veil-vpn.example

# GitHub repo (org/name) whose Releases host the client downloads.
# Download buttons point at:
#   https://github.com/<NEXT_PUBLIC_GITHUB_REPO>/releases/latest/download/<asset>
# Create releases there with assets named exactly as in lib/config.ts
# (VeilVPN-Setup.exe, VeilVPN.msix, VeilVPN.apk, VeilVPN.dmg).
NEXT_PUBLIC_GITHUB_REPO=YOUR_GITHUB_ORG/veil-vpn

# Version string shown on the download page (e.g. v0.1.0).
NEXT_PUBLIC_APP_VERSION=v0.1.0

# Optional: public URL of the marketing site itself (used for canonical/OG tags).
NEXT_PUBLIC_SITE_URL=https://veil-vpn.example

# Optional: URL of a hosted web portal for signup/billing. If unset, the site
# directs users to create their account and subscribe inside the app.
NEXT_PUBLIC_APP_URL=
